copyleft_mod(){
  source "$mountpoint/var/version"
  local copyleft_text='\\n\\nTHIS MODDED SYSTEM IS NOT FOR RESALE!\\n\\nThis console was modded using the free Hakchi2 CE software. If you bought an already modded system, you were scammed.\\n'
  local copyleft_cache="$mountpoint/var/copyleft"
  
  find "$mountpoint/usr/share/" -name "strings.*" -print | while read l ; do
    local modified_string_filename="$copyleft_cache/${l#$mountpoint/usr/share/}"
    
    mkdir -p "$(dirname "$modified_string_filename")"
    [ -f "$modified_string_filename" ] || sed -e "s/\"sys_copyright_games_HeadText\": \"\",/\"sys_copyright_games_HeadText\": \"Boot Version=$bootVersion, Hakchi Version=$hakchiVersion, Kernel Version=$kernelVersion $copyleft_text\",/g" "$l" > "$modified_string_filename"
    mount_bind "$modified_string_filename" "$l"
  done
}
copyleft_mod
